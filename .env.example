# Copy this file to .env.local and fill in real values. .env.local is gitignored
# and must never be committed.

# Supabase project credentials. Find these in your Supabase project under
# Settings -> API. SUPABASE_SERVICE_ROLE_KEY is secret, server-side only,
# never expose it to the browser or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin login, created by running: node --env-file=.env.local scripts/seed-admin.ts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Long random string used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Public site URL, used in metadata, sitemap, and JSON-LD. Update once a real
# domain is purchased.
NEXT_PUBLIC_SITE_URL=https://www.powernexasolutions.site

# WhatsApp number in international format, no plus sign or spaces. Used for
# general "chat with us" links (header, footer, float button, etc).
NEXT_PUBLIC_WHATSAPP_NUMBER=2348132097317

# WhatsApp number that receives the quote form's auto-opened WhatsApp message.
# Same format as above.
NEXT_PUBLIC_QUOTE_WHATSAPP_NUMBER=2349065560594

# Optional. Leave blank until a Google Analytics 4 property exists.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Long random string that protects /api/cron/sync-equipment-prices from being
# triggered by anyone but Vercel Cron. Generate one with: openssl rand -base64 32
# Set it in Vercel too; Vercel automatically sends it as a Bearer token on
# cron-triggered requests once the env var exists.
CRON_SECRET=
